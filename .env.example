# Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here
# Gemini Model Selection (e.g., gemini-2.5-flash or gemini-2.5-pro)
GEMINI_MODEL=gemini-2.5-flash
# Gemini Fallback Model Selection (e.g., gemini-2.0-flash or gemini-3.1-pro)
GEMINI_FALLBACK_MODEL=gemini-2.0-flash
# API Base URL
API_BASE_URL=https://api.soapy-bubbles.com/api/v1

# Database Path
DATABASE_PATH=./data/conversations.db

# Log Level (debug, info, warn, error)
LOG_LEVEL=info

# Customer IP (default for WhatsApp)
CUSTOMER_IP=0.0.0.0

# Admin phone numbers, comma-separated, without + or 00 prefixes
ADMIN_PHONES=965XXXXXXXXX,965YYYYYYYYY

# Rate Limiter Settings
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_PER_WINDOW=100
RATE_LIMIT_WINDOW_MINUTES=5

# Status API (defaults shown)
STATUS_API_PORT=3002
STATUS_API_HOST=127.0.0.1
# Required when exposing the API outside the local host. Generate a long random value.
STATUS_API_TOKEN=
# Set to the dashboard origin in production, or * when browser access is not restricted.
STATUS_API_CORS_ORIGIN=*
